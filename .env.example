# Public URL the site is served from (used for canonical URLs and social cards).
NEXT_PUBLIC_SITE_URL=

# Store listings, overriding the ones in lib/constants.ts. A store with no listing
# shows a "Coming soon" badge.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Where the early-access form POSTs {"email": "..."} as JSON (Formspree, Loops,
# your own API route, ...). Without it the form explains it isn't connected yet.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
